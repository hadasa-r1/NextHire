{
  // Group B frontend. Kept in sync with the backend tsconfig where it makes
  // sense (strict, noUncheckedIndexedAccess, exactOptionalPropertyTypes,
  // verbatimModuleSyntax) so both halves of the repo lint the same way.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",

    "paths": {
      "@scoring": ["../server/src/validation/scoring.mts"],
      "@evaluation-demo": ["../server/src/demo/evaluation-data.mts"],
      "@resume-policy": ["../server/src/validation/resume-file.mts"],
      "@validation": ["../server/src/validation/field-rules.mts"],
      "@ds/*": ["./src/design-system/*"],
      "@/*": ["./src/*"]
    },

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "tests", "vite.config.ts"]
}
