{
  "name": "nexthire-group-b",
  "version": "1.0.0",
  "private": true,
  "description": "NEXTHIRE Group B server and client workspaces.",
  "license": "ISC",
  "workspaces": ["server", "client"],
  "scripts": {
    "dev": "npm run dev -w server",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "start": "npm start -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "build": "npm run build -w client",
    "db:check": "npm run db:check -w server",
    "test": "npm test -w server",
    "test:controller": "npm run test:controller -w server",
    "test:routes": "npm run test:routes -w server",
    "test:app": "npm run test:app -w server"
  }
}