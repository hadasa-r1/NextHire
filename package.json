{
  "name": "nexthire-group-b",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:check": "tsx src/scripts/check-database.ts",
    "test": "tsx --test tests/repository.test.ts tests/generic.controller.test.ts tests/routes.test.ts tests/app.test.ts",
    "test:controller": "tsx --test tests/generic.controller.test.ts",
    "test:routes": "tsx --test tests/generic.controller.test.ts tests/routes.test.ts",
    "test:app": "tsx --test tests/app.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "//": "The backend lives here at the root; the Group B frontend is the 'client' workspace. Both share the design-system/ folder, so client dependencies (React, etc.) hoist to the root node_modules where design-system/*.tsx can resolve them.",
  "workspaces": [
    "client"
  ],
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.9.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
